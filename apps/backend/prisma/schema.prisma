generator client {
  provider     = "prisma-client"
  output       = "./generated"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String @id @default(uuid())
  fullName     String @map("full_name")
  email        String @unique @map("email")
  passwordHash String @map("password_hash")

  invoices Invoice[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Invoice {
  id               String   @id @default(uuid())
  invoiceNumber    String   @unique @map("invoice_number")
  invoiceReference String?  @map("invoice_reference")
  invoiceDate      DateTime @map("invoice_date") @db.Date
  dueDate          DateTime @map("due_date") @db.Date
  currency         String
  currencySymbol   String   @map("currency_symbol")
  description      String?
  status           String   @default("Draft")

  customerName    String  @map("customer_name")
  customerEmail   String  @map("customer_email")
  customerMobile  String? @map("customer_mobile")
  customerAddress String? @map("customer_address")

  // Tax rate (%) and discount are invoice-level inputs; totals are computed
  taxRate         Decimal @default(10) @map("tax_rate") @db.Decimal(5, 2)
  invoiceSubTotal Decimal @map("invoice_sub_total") @db.Decimal(12, 2)
  totalTax        Decimal @map("total_tax") @db.Decimal(12, 2)
  totalDiscount   Decimal @map("total_discount") @db.Decimal(12, 2)
  totalAmount     Decimal @map("total_amount") @db.Decimal(12, 2)
  totalPaid       Decimal @default(0) @map("total_paid") @db.Decimal(12, 2)
  balanceAmount   Decimal @map("balance_amount") @db.Decimal(12, 2)

  createdBy String        @map("created_by")
  creator   User          @relation(fields: [createdBy], references: [id])
  items     InvoiceItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("invoices")
}

model InvoiceItem {
  id       String  @id @default(uuid())
  name     String
  quantity Int
  rate     Decimal @db.Decimal(12, 2)

  invoiceId String  @map("invoice_id")
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("invoice_items")
}
